# Hermes Office - copy to .env (never commit .env). Names are identical in Python,
# .env and server/biz-events.js (docs/hermes-office/ENV-VARS.md).

# --- Office server -------------------------------------------------------
OFFICE_URL=http://127.0.0.1:3334
# Not a made-up value: the server writes it on its first start.
#   export OFFICE_TOKEN=$(cat "${AGENT_OFFICE_HOME:-$HOME/.agent-office}/auth-token")
# If the server is rotated with `npm run rotate-token`, update this too or every
# event will 401 and land in the DLQ.
# hermes_bridge/env.py reads both forms, so this line works as-is:
# OFFICE_TOKEN=$(cat "${AGENT_OFFICE_HOME:-$HOME/.agent-office}/auth-token")
OFFICE_TOKEN=

# --- Sidecar -------------------------------------------------------------
SIDECAR_URL=http://127.0.0.1:8765
# Required from W3 on (webhook routes): the sidecar refuses to start without them.
WEBHOOK_SECRET=
MIDTRANS_SERVER_KEY=

# --- Episode pipeline (W3) ------------------------------------------------
# HERMES_MEDIA_DIR=~/.hermes-office/media
# HERMES_ENCODER=ffmpeg          # 'copy' only for a dev box without ffmpeg
# HERMES_GLOSSARY=~/.hermes-office/glossary/id-en.json
# TRANSLATION_PROVIDER=local     # local | deepl | openai (remote needs its key)

# --- Support inbox (W5) --------------------------------------------------
# Reading the mailbox needs IMAP; replying needs SMTP (above). Same account is fine.
# Without IMAP_HOST/IMAP_USER, email_check logs once an hour and creates no tickets.
# IMAP_HOST=imap.contoh.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# IMAP_MAX_PER_RUN=10

# --- Growth (W6) ---------------------------------------------------------
# One JSON export from AniWatch is the only source of watch numbers this fork
# has: {"episodes": [{"episode_id", "views", "completions"}], "history":
# [{"user_id", "episode_id"}]}. Without it Analytics reports local facts only.
# ANALYTICS_FEED=~/.hermes-office/aniwatch-export.json
# AniWatch's own SQLite file for the Sunday recommendation batch; empty means
# the batch writes media/published/recommendations.jsonl instead.
# RECOMMENDATION_DB=~/.hermes-office/aniwatch.db
# SEO_SITE_URL=https://aniwatch.example

# --- Finance, Legal, Security (W9) ---------------------------------------
# Access events for SecOps: one JSON object per line, e.g.
#   {"at": 1731676800, "type": "login_failed", "ip": "203.0.113.7"}
# Types the rules count: login_failed, session_open, request. Without this file
# the three request rules do not run and /security says so; chargeback_count
# reads payment_events and works without it.
# SECURITY_EVENT_FEED=~/.hermes-office/security-events.jsonl

# --- Models --------------------------------------------------------------
HERMES_MODEL=nous-hermes-2
OLLAMA_URL=http://127.0.0.1:11434

# --- Knowledge base ------------------------------------------------------
KB_BACKEND=sqlite
KB_MIN_SCORE=0.5

LOG_LEVEL=INFO
